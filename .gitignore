# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# migration artifact (see scripts/migrate-neon.md)
flockradar.dump

# typescript
*.tsbuildinfo
next-env.d.ts

# python (scratch tooling)
__pycache__/
*.pyc

# local agent artifacts (auto-generated or internal, never public)
.hermes/
AGENTS.md
CLAUDE.md
.claude/

# internal planning docs (keep local, not for the public repo)
PRD.md
plan.md

# stray design artifacts
logo transparent.png
docs/btc-chip.svg

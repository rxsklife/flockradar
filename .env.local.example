# ── FlockRadar environment ─────────────────────────────────────────────
# Copy to .env.local for local dev; set the same keys in Vercel (Project
# Settings → Environment Variables) and in GitHub repo secrets where noted.

# Local development (Docker PostGIS) — the running container 'flockradar-db' on :5433
DATABASE_URL=postgresql://flockradar:***@localhost:5433/flockradar

# Production — Neon Postgres (PostGIS enabled). Create a branch database,
# enable PostGIS, restore the dump (see scripts/migrate-neon.md).
# DATABASE_URL=postgresql://[user]:***@[host].neon.tech/[db]?sslmode=require

# ── Telegram review bot ────────────────────────────────────────────────
# Bot token from @BotFather. When set, new tips and corrections are DM'd
# to TELEGRAM_CHAT_ID with Approve/Deny buttons.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Secret used to verify Telegram webhook calls (setWebhook secret_token).
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ── Site ───────────────────────────────────────────────────────────────
# Public base URL. Used by the webhook registration and GH Actions warmup.
SITE_URL=http://localhost:3000

# ── GitHub Actions secrets (NOT needed locally) ────────────────────────
# Set in repo Settings → Secrets and variables → Actions:
#   DATABASE_URL          → Neon connection string (prod)
#   TELEGRAM_BOT_TOKEN    → same as above
#   TELEGRAM_CHAT_ID      → same as above
# Repo variable:
#   SITE_URL              → https://flockradar.com
